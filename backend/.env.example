APP_NAME=DLX Yuki WMS V3
# This generic template is non-destructive. WMS_ENV must be set explicitly to
# development, test, or production. Missing values never authorize reset/seed.
WMS_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
# Example only. Development may target only dlx_yuki_wms_dev; automated tests
# may target only dlx_yuki_wms_test. The protected dlx_yuki_wms main database
# is never authorized for destructive tooling.
DATABASE_URL=postgresql+psycopg://wms_dev_user:FAKE_DEV_PASSWORD@localhost:5432/dlx_yuki_wms_dev
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]
BUSINESS_TIMEZONE=America/Los_Angeles
POSTGRES_BACKUP_DIR=../backups
DOCUMENT_STORAGE_ROOT=data/documents
DOCUMENT_MAX_UPLOAD_BYTES=26214400
